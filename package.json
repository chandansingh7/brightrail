{
  "name": "brightrail",
  "version": "0.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve funfair",
    "serve:funfair": "ng serve funfair",
    "build": "ng build",
    "build:lib": "ng build brightrail && node scripts/patch-package-manifest.mjs",
    "pack:lib": "npm run build:lib && cd dist/brightrail && npm pack --pack-destination ../..",
    "publish:lib": "bash scripts/publish-lib.sh",
    "build:funfair": "ng build funfair",
    "build:midway": "ng build midway",
    "build:all": "npm run build:lib && ng build funfair && ng build midway",
    "verify:package": "npm run build:lib && npm install && ng build midway",
    "verify:claims": "node scripts/verify-library-claims.mjs",
    "setup": "bash scripts/setup.sh",
    "dev:all": "bash scripts/build-and-run.sh",
    "deploy:pages": "bash scripts/deploy-gh-pages.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:brightrail": "ng test brightrail --no-watch --browsers=ChromeHeadless",
    "e2e:serve": "npm run build:lib && ng build funfair --configuration=production && npx --yes serve dist/funfair/browser -l ${E2E_PORT:-4321} -s",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "e2e:a11y:contrast": "playwright test e2e/a11y-contrast.spec.ts",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "e2e:update-snapshots": "playwright test e2e/visual.spec.ts --update-snapshots",
    "e2e:gates": "bash scripts/e2e-gates.sh"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/aria": "21.2.14",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "brightrail": "file:dist/brightrail",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.16",
    "@angular/cli": "21.2.16",
    "@angular/compiler-cli": "21.2.17",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.3",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "ip-address": "10.2.0"
  }
}
