{
  "name": "facl-ui",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve funfair",
    "serve:funfair": "ng serve funfair",
    "build": "ng build",
    "build:lib": "ng build facl",
    "build:funfair": "ng build funfair",
    "build:midway": "ng build midway",
    "build:all": "ng build facl && ng build funfair && ng build midway",
    "verify:package": "ng build facl && npm install && ng build midway",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:facl": "ng test facl --no-watch --browsers=ChromeHeadless"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@facl/ui": "file:dist/facl",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
