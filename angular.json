{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "ef3d093e-d336-4bad-a85b-7dcdccdb9d11"
  },
  "newProjectRoot": "projects",
  "projects": {
    "brightrail": {
      "projectType": "library",
      "root": "projects/brightrail",
      "sourceRoot": "projects/brightrail/src",
      "prefix": "brightrail",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/brightrail/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/brightrail/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/brightrail/tsconfig.spec.json"
          }
        }
      }
    },
    "funfair": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/funfair",
      "sourceRoot": "projects/funfair/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/funfair/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/funfair/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["projects/brightrail/src/lib/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/funfair/public"
              }
            ],
            "styles": [
              "projects/funfair/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "28kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "funfair:build:production"
            },
            "development": {
              "buildTarget": "funfair:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/funfair/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["projects/brightrail/src/lib/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/funfair/public"
              }
            ],
            "styles": [
              "projects/funfair/src/styles.scss"
            ]
          }
        }
      }
    },
    "midway": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/midway",
      "sourceRoot": "projects/midway/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/midway/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/midway/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["projects/brightrail/src/lib/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/midway/public"
              }
            ],
            "styles": [
              "projects/midway/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "30kB",
                  "maximumError": "50kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "midway:build:production"
            },
            "development": {
              "buildTarget": "midway:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/midway/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["projects/brightrail/src/lib/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/midway/public"
              }
            ],
            "styles": [
              "projects/midway/src/styles.scss"
            ]
          }
        }
      }
    }
  }
}
