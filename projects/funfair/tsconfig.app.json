/* Funfair resolves `brightrail` from library source for fast iteration (see doc/PLAN.md). */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [],
    "baseUrl": "../../",
    "paths": {
      "brightrail": ["projects/brightrail/src/public-api.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
